{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main", "pdf-export-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:write-files",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA/**",
        "$APPLOCALDATA/**",
        "$RESOURCE/**"
      ]
    },
    "opener:default",
    "log:default",
    "window-state:default"
  ]
}